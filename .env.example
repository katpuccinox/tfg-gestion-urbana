# Copia este archivo a ".env" (mismo directorio que docker-compose.yml) y ajusta
# los valores. ".env" no se sube a git (ver .gitignore) -- este ejemplo sí, para que
# cualquiera que despliegue el proyecto sepa qué variables existen.

# --- Dominio y HTTPS (servicio "caddy") ---
# En local no hace falta tocar nada: sin DOMAIN, Caddy sirve en localhost (HTTP/HTTPS
# con certificado local). Para desplegar con un dominio real, mañana solo hay que:
#   1) apuntar el DNS (registro A) de tu dominio a la IP de este servidor,
#   2) poner aquí ese dominio y un email de contacto,
#   3) `docker compose up -d caddy` (o reiniciar el stack).
# Caddy obtiene y renueva el certificado HTTPS automáticamente (Let's Encrypt).
DOMAIN=localhost
ACME_EMAIL=admin@example.com

# --- Seguridad ---
# Cambia esto por una cadena larga y aleatoria antes de desplegar en un dominio
# público. Cualquiera con este valor puede firmar tokens de sesión válidos.
JWT_SECRET=cambia-esta-clave-larga-en-produccion-2026

# --- Ollama (interpretación por IA en la pestaña Análisis) ---
# http://host.docker.internal:11434 asume Ollama corriendo en la máquina anfitriona
# con Docker Desktop (Windows/Mac). En un servidor Linux sin Docker Desktop, o si
# Ollama corre en otra máquina, cambia esto a esa IP/host real.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=90
